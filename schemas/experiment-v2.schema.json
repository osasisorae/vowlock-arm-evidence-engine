{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osasisorae.github.io/vowlock-arm-evidence-engine/schemas/experiment-v2.schema.json",
  "title": "VowLock Arm Evidence Engine V2 experiment manifest",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "registered_at",
    "status",
    "separation",
    "runtime",
    "arm_hosts",
    "models",
    "workloads",
    "resource_metrics",
    "agent_evaluation",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "study_id": {"type": "string", "minLength": 1},
    "registered_at": {"type": "string", "format": "date-time"},
    "status": {"const": "pre-registered-before-execution"},
    "separation": {
      "type": "object",
      "required": ["prior_study", "rule"]
    },
    "cost_policy": {"type": "string"},
    "runtime": {
      "type": "object",
      "required": ["repository", "commit", "baseline_cmake", "optimized_cmake"]
    },
    "arm_hosts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "kind", "role"]
      }
    },
    "models": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "family", "quantization", "filename", "url", "sha256", "bytes", "runtime_variants"],
        "properties": {
          "bytes": {"type": "integer", "minimum": 1},
          "runtime_variants": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["baseline", "kleidiai"]}
          }
        }
      }
    },
    "workloads": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "prompt_tokens", "generation_tokens", "repetitions", "purpose"],
        "properties": {
          "prompt_tokens": {"type": "integer", "minimum": 1},
          "generation_tokens": {"type": "integer", "minimum": 1},
          "repetitions": {"type": "integer", "minimum": 1}
        }
      }
    },
    "resource_metrics": {"type": "object"},
    "agent_evaluation": {
      "type": "object",
      "required": ["scope", "fixtures", "hard_failures", "quality_checks"]
    },
    "claims": {
      "type": "object",
      "required": ["primary", "secondary", "no_claim"]
    }
  },
  "additionalProperties": true
}
