{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osasisorae.github.io/vowlock-arm-evidence-engine/schemas/experiment-v5.schema.json",
  "title": "VowLock Verified Explanation Compiler V5 manifest",
  "type": "object",
  "required": ["$schema", "schema_version", "study_id", "registered_at", "status", "prior_result_commit", "research_question", "separation", "cost_policy", "host", "state_space", "policy", "variants", "compiler_contract", "exhaustive_invariants", "mutations", "benchmark", "hard_gates", "claims"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "5.0"},
    "study_id": {"const": "vowlock-verified-explanation-compiler-v5"},
    "registered_at": {"type": "string", "format": "date-time"},
    "status": {"const": "pre-registered-before-implementation-and-execution"},
    "prior_result_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "research_question": {"type": "string", "minLength": 1},
    "separation": {"type": "object", "required": ["prior_study", "rule"]},
    "cost_policy": {"type": "string", "minLength": 1},
    "host": {"type": "object", "required": ["id", "kind", "minimum_logical_cpus"]},
    "state_space": {"type": "object", "required": ["device_class", "device_certified", "original_verifier_values_captured", "verifier_restored", "reboot_persistence_checked", "play_protect_scan", "device_owner_active", "expected_cartesian_states"]},
    "policy": {"type": "object", "required": ["terminal_precedence", "missing_precedence", "pass_condition"]},
    "variants": {"type": "array", "minItems": 3, "maxItems": 3},
    "compiler_contract": {"type": "object", "required": ["authority_fields", "provenance_fields", "model_dependency", "network_dependency", "generated_commands", "same_state_same_bytes"]},
    "exhaustive_invariants": {"type": "array", "minItems": 9},
    "mutations": {"type": "array", "minItems": 8},
    "benchmark": {"type": "object", "required": ["warmup_complete_state_space_rounds", "measured_complete_state_space_rounds", "variant_order_per_round", "clock", "record"]},
    "hard_gates": {"type": "object", "required": ["state_count", "invariant_pass_rate", "deterministic_repeatability_rate", "mutation_recall", "unavailable_metrics_are_reported_not_estimated"]},
    "claims": {"type": "object", "required": ["primary", "performance", "human_boundary", "formal_boundary"]}
  },
  "additionalProperties": false
}
