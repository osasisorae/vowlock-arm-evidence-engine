{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osasisorae.github.io/vowlock-arm-evidence-engine/schemas/experiment-v3.schema.json",
  "title": "VowLock Arm Runtime Policy V3 experiment manifest",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "registered_at",
    "status",
    "proposal_commit",
    "separation",
    "cost_policy",
    "runtime",
    "arm_hosts",
    "model",
    "legal_search_space",
    "search",
    "registered_probes",
    "variants",
    "evaluation",
    "metrics",
    "hard_gates",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "study_id": {"const": "vowlock-arm-runtime-policy-v3"},
    "registered_at": {"type": "string", "format": "date-time"},
    "status": {"const": "pre-registered-before-implementation-and-execution"},
    "proposal_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "separation": {"type": "object", "required": ["prior_study", "rule"]},
    "cost_policy": {"type": "string", "minLength": 1},
    "runtime": {"type": "object", "required": ["repository", "commit", "cmake", "backend"]},
    "arm_hosts": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "kind", "role"]}},
    "model": {"type": "object", "required": ["id", "family", "quantization", "filename", "url", "sha256", "bytes"]},
    "legal_search_space": {"type": "object", "required": ["decode_threads", "prompt_threads", "physical_micro_batch", "cache_prompt", "cpu_affinity"]},
    "search": {"type": "object", "required": ["method", "stage_1", "stage_2", "stage_3", "tie_break_order", "no_generated_commands"]},
    "registered_probes": {"type": "array", "minItems": 4},
    "variants": {"type": "array", "minItems": 5},
    "evaluation": {"type": "object", "required": ["scope", "development_fixtures", "sealed_fixtures", "mutations", "temperature", "seed", "max_generated_tokens", "warmup_requests_per_policy", "sealed_repetitions", "server_endpoint", "stream"]},
    "metrics": {"type": "object", "required": ["primary", "secondary", "safe_fast_at_5"]},
    "hard_gates": {"type": "object", "required": ["all_retained_outputs_pass", "dangerous_mutation_recall", "minimum_median_complete_latency_improvement_percent", "maximum_p95_regression_percent", "cache_claim_requires_positive_reused_token_count", "unavailable_metrics_are_reported_not_estimated"]},
    "claims": {"type": "object", "required": ["primary", "cache", "no_claim"]}
  },
  "additionalProperties": false
}
